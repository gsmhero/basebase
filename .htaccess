Options -Indexes
DirectoryIndex index.php index.html

# Never serve secrets or source
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On

# Block direct access to non-public folders
RewriteRule ^(src|database|\.github)(/|$) - [F,L]

# Serve everything from /public
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
